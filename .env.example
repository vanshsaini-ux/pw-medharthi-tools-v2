# ---- Public site config ----
NEXT_PUBLIC_SITE_URL=https://tools.pwmedharthi.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_BRAND_NAME=PW Medharthi
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://www.pwmedharthi.com/privacy-policy
NEXT_PUBLIC_WHATSAPP_NUMBER=+911234567890

# ---- Server-only secrets (NEVER exposed to the browser) ----
# URL of the deployed Google Apps Script web app (see /google-apps-script/Code.gs)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Shared secret checked inside the Apps Script - generate any long random string
GOOGLE_SHEETS_SHARED_SECRET=replace-with-a-long-random-string

# Optional: enables live LLM-generated roadmaps in the AI Career Roadmap Generator.
# If left empty, the tool automatically falls back to the deterministic
# template-based roadmap engine (fully functional either way).
ANTHROPIC_API_KEY=
